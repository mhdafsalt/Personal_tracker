# Next.js Environment Variables

# MongoDB Atlas (Required for cloud database persistence on Vercel)
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/pk_workspace?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pk_workspace?retryWrites=true&w=majority
MONGODB_DB_NAME=pk_workspace
WORKSPACE_ID=muhammed_anas_default

# Optional: Gemini API Key for AI Assistant features
GEMINI_API_KEY=

# Optional: Backend URL (Only needed if running a separate external Node.js backend server)
# Leave empty on Vercel to use the built-in Next.js serverless API routes.
BACKEND_URL=
