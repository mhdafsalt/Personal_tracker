# PK Workspace & Finance Manager Environment Variables
# Copy to backend/.env and frontend/.env.local (or set directly in Vercel Environment Variables)

# MongoDB Atlas Database URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pk_workspace?retryWrites=true&w=majority
MONGODB_DB_NAME=pk_workspace
WORKSPACE_ID=muhammed_anas_default

# Optional: Google Gemini AI Key
GEMINI_API_KEY=

# Local Backend Port (Node.js Express)
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
