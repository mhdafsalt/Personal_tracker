PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# MongoDB Atlas connection string
# Create a free cluster at https://cloud.mongodb.com
# Database Access -> Add user, Network Access -> Allow your IP (or 0.0.0.0/0 for development)
# Format:
# mongodb+srv://<username>:<password>@<cluster>.mongodb.net/pk_workspace?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/pk_workspace?retryWrites=true&w=majority
MONGODB_DB_NAME=pk_workspace
WORKSPACE_ID=muhammed_anas_default

# Optional: Gemini AI
GEMINI_API_KEY=
